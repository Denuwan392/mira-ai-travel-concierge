# Fixed assignment evaluation clock. Choose another ISO date when testing current validity.
AS_OF_DATE=2026-11-19
MIRA_ORIGIN=http://127.0.0.1:3000

# Generate each token independently with openssl rand -hex 32.
MIRA_STAFF_TOKEN=
MIRA_EDITOR_TOKEN=
MIRA_APPROVER_TOKEN=

# Set both for structured suggestions and draft generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional remote trace export. Keep traces private.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Use 1 only behind local or deployed HTTPS.
MIRA_SECURE_COOKIE=0

# Logging defaults. Set LOG_FORMAT=json for machine-readable logs.
LOG_LEVEL=INFO
LOG_FORMAT=pretty
LOG_LLM_DETAILS=false

# Optional bootstrap for cookie-authenticated staff management.
MIRA_ADMIN_EMAIL=
MIRA_ADMIN_PASSWORD=
# Optional SQLite path, content root and extra trusted frontend origins.
# MIRA_DB=.mira/mira.sqlite3
# MIRA_DATA=...
# MIRA_ADDITIONAL_ORIGINS=http://127.0.0.1:5175
# Optional paths for alternative deployment layouts.
# MIRA_EVAL_REPORT=evals/report/report.json
# MIRA_API_URL=http://127.0.0.1:8000
# MIRA_COMPASS_URL=http://127.0.0.1:5175
